FROM codercom/code-server:latest

USER root

# Install nginx
RUN apt-get update && apt-get install -y nginx && apt-get clean

# Create sandbox and copy README
RUN mkdir -p /root/sandbox
COPY README.md /root/sandbox/README.md

# VS Code settings
RUN mkdir -p /root/.local/share/code-server/User && \
    echo '{ \
      "workbench.startupEditor": "none", \
      "workbench.colorTheme": "Default Dark+" \
    }' > /root/.local/share/code-server/User/settings.json

# Install extensions
RUN code-server --install-extension rooveterinaryinc.roo-cline && \
    code-server --install-extension yzhang.markdown-all-in-one

# Copy nginx config and code-server config
COPY nginx.conf /etc/nginx/nginx.conf
COPY config.yaml /root/.config/code-server/config.yaml

# Add startup script to run both nginx and code-server
COPY start.sh /start.sh
RUN chmod +x /start.sh

WORKDIR /root/sandbox
EXPOSE 80

CMD ["/start.sh"]
